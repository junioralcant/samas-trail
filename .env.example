# Nome do evento exibido no site
EVENT_NAME="Desafio Trail Run"
NEXT_PUBLIC_EVENT_NAME="Desafio Trail Run"

# Data e local do evento (exibidos na página)
NEXT_PUBLIC_EVENT_DATE="15 de novembro de 2026"
NEXT_PUBLIC_EVENT_LOCATION="Parque Estadual — Trilha da Serra"

# Preços em reais (use ponto como separador decimal)
PRECO_8KM="120.00"
PRECO_18KM="150.00"
NEXT_PUBLIC_PRECO_8KM="120.00"
NEXT_PUBLIC_PRECO_18KM="150.00"

# Lote de inscricao exibido na pagina (rotulo livre, ex: "2º lote")
NEXT_PUBLIC_LOTE_ATUAL="1º lote"

# Credenciais do Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
# Use as credenciais de TESTE durante o desenvolvimento
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"

# URL pública da aplicação (necessária para back_urls e webhook do Mercado Pago)
APP_URL="http://localhost:3000"

# Senha do painel de administração (/admin)
ADMIN_PASSWORD="troque-esta-senha"

# Caminho do banco SQLite (no Railway aponte para o volume, ex: /data/corrida.db)
DATABASE_PATH="./data/corrida.db"

# E-mail de confirmação (Resend — https://resend.com)
RESEND_API_KEY="re_sua_api_key"
EMAIL_FROM="SAMAS TRAIL <inscricoes@samastrail.com.br>"
EMAIL_REPLY_TO="seu-email@gmail.com"
